# Copier ce fichier en .env (jamais commité) et remplir les valeurs.

# Clé secrète des sessions : génère-la avec
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=elix
# Nombre de connexions MySQL ouvertes (mettre 2 chez un hébergeur gratuit comme alwaysdata)
DB_POOL_SIZE=5

# Mettre 1 si le site est servi en HTTPS (ex. alwaysdata)
SESSION_COOKIE_SECURE=0
